---
// SearchButton.astro

import { Icon } from 'astro-icon/components';
import Search from 'astro-pagefind/components/Search.astro';
---

<button id="searchButton" class="p-2 cursor-pointer hover-scale hover-rotate" aria-label="Open search">
  <Icon name="tabler:search" class="w-5 h-5" />
</button>

<!-- Search Modal -->
<div
  id="searchModal"
  class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center hidden overflow-y-auto py-8"
>
  <div class="bg-white rounded-lg p-6 max-w-2xl w-full mx-4 relative my-auto max-h-[90vh] overflow-y-auto">
    <button id="closeSearchModal" class="absolute top-3 right-3 text-gray-500 hover:text-gray-700 z-10">
      <Icon name="tabler:x" class="w-5 h-5" />
    </button>
    <p class="text-xl text-black font-bold mb-4">Search</p>
    <div class="w-full">
      <Search
        instance="search"
        className="pagefind-ui"
        searchboxOptions={{ 'max-results': 5, 'hide-shortcut': true }}
      />
    </div>
  </div>
</div>

<script>
  // Wait for the DOM to be fully loaded
  document.addEventListener('DOMContentLoaded', () => {
    const searchButton = document.getElementById('searchButton');
    const searchModal = document.getElementById('searchModal');
    const closeSearchModal = document.getElementById('closeSearchModal');

    // Only proceed if all elements are found
    if (!searchButton || !searchModal || !closeSearchModal) {
      console.error('Search modal elements not found');
      return;
    }

    // Function to open the modal
    const openModal = () => {
      searchModal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden'); // Prevent scrolling when modal is open

      // Focus the searchbox once it's visible (the web component exposes focus())
      setTimeout(() => {
        const searchbox = document.querySelector('pagefind-searchbox') as HTMLElement | null;
        searchbox?.focus();
      }, 100);
    };

    // Function to close the modal
    const closeModal = () => {
      searchModal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    };

    // Event listeners
    searchButton.addEventListener('click', openModal);
    closeSearchModal.addEventListener('click', closeModal);

    // Close modal when clicking outside the modal content
    searchModal.addEventListener('click', (e) => {
      if (e.target === searchModal) {
        closeModal();
      }
    });

    // Close modal with Escape key, open it with the searchbox's Cmd/Ctrl+K shortcut
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !searchModal.classList.contains('hidden')) {
        closeModal();
      }

      if (e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey) && searchModal.classList.contains('hidden')) {
        e.preventDefault();
        openModal();
      }
    });
  });
</script>

<style is:global>
  .pagefind-ui {
    --pf-searchbox-max-width: 100%;
    --pf-font: sans-serif;
    --pf-text: black;
    --pf-border: slategrey;
    --pf-border-radius: 0.25rem;

    width: 100%;
  }

  /*
   * @pagefind/component-ui ships its rules behind an `:is(*, #\#)` specificity hack,
   * so plain selectors lose to it — these overrides need `!important` to land.
   */

  /* Let the dropdown flow inline instead of overlaying, so it isn't clipped by the modal */
  .pagefind-ui .pf-searchbox-dropdown {
    position: relative !important;
    max-height: none !important;
    box-shadow:
      0 10px 10px -5px rgba(0, 0, 0, 0.2),
      0 2px 2px 0 rgba(0, 0, 0, 0.1) !important;
  }

  .pagefind-ui .pf-searchbox-result-title {
    color: navy !important;
  }

  .pagefind-ui .pf-searchbox-result-excerpt {
    color: black !important;
  }

  /* Additional styles for modal */
  body.overflow-hidden {
    overflow: hidden;
  }
</style>
