---
import PageLayout from '~/layouts/PageLayout.astro';
import avatarImage from '~/assets/images/avatar.jpeg';
import meImage from '~/assets/images/me.png';
import eskateImage from '~/assets/images/about/eskate.jpg';
import teslaImage from '~/assets/images/about/tesla.jpg';
import entrepreneurImage from '~/assets/images/about/entrepreneur.jpg';
import { Image } from 'astro:assets';

const timelineItems = [
  {
    dates: '1995-2013',
    description: `
      <p>I was born in Madrid, Spain. I spent my childhood experimenting with <strong>electronics</strong> and <strong>building things</strong> on my own.</p>
      <p>I <strong>picked up code when I was 14</strong>. My teachers would grab me out of class to <strong>fix the school's computers</strong>.</p>
    `,
    image: eskateImage,
    imageAlt: 'Electric skateboard',
  },
  {
    dates: '2013-2019',
    description: `
      <p>I studied an <strong>engineering degree and two masters degrees</strong> in Madrid and a year in Philadelphia, USA; while doing many code and electronic projects on the side.</p>
      <p>It was during this time that I decided I <strong>wanted to be an entrepreneur</strong>.</p>
    `,
  },
  {
    dates: '2020',
    description: `
      <p>I started working as a <strong>Quality Intern at Correos</strong> (the Spanish postal service) and quickly became the <strong>go-to person for data analysis and automation</strong>.</p>
      <p>I was the <strong>first person in the department who knew how to code</strong> and automate data analysis tasks.</p>
    `,
  },
  {
    dates: '2020-2023',
    description: `
      <p>I started working as a <strong>Quality Engineer at Tesla</strong>, I worked in <strong>Norway, France, Germany, United Arab Emirates and Spain</strong>.</p>
      <p>My main job was to <strong>analyze service and factory data</strong> and fix the top issues the European fleet was having.</p>
    `,
    image: teslaImage,
    imageAlt: 'Tesla',
  },
  {
    dates: '2023',
    description: `
      <p>I <strong>left Tesla in May</strong> in a bet to start entrepreneurship.</p>
      <p>I spent the next <strong>7 months learning full stack development</strong> (Django + React) as well as deployments with Docker.</p>
    `,
  },
  {
    dates: '2024',
    description: `
      <p>I <strong>co-founded an email productivity startup</strong> with a friend I met the past year. It was starting to gain traction when disputes between us started happening. In the end I decided it was best for us to <strong>part ways</strong>.</p>
      <p>I then worked a couple of months for <strong>Placeholder</strong>, a Canada/US based real estate startup.</p>
    `,
  },
  {
    dates: '2025',
    description: `
      <p>Decided to start again, <strong>solo-founded estavia.ai</strong>, a real estate lead automation tool for the Spanish market.</p>
      <p>In December, after <strong>3 months of hard marketing, cold calls and networking</strong>, I decided to stop putting all my time into it. It's still running and being maintained for a few real estate agencies.</p>
    `,
    image: entrepreneurImage,
    imageAlt: 'Entrepreneur',
  },
  {
    dates: '2026-Present',
    description: `
      <p>While I do <strong>software consulting</strong> I keep trying new stuff to see what I enjoy doing.</p>
      <p>One of those crazy ideas was starting a <a href="https://www.youtube.com/@onticdani" target="_blank" rel="noopener"><strong>YouTube channel about enthusiast cars</strong></a>.</p>
    `
  },
  // Add more timeline items here
];

const services = [
  'Internal software tools',
  'Web apps',
  'Automations',
  'AI integrations',
  'Websites',
  'Grafana data dashboards',
];
---

<PageLayout>
  <section id="hero" class="relative overflow-hidden rounded-2xl">
    <!-- subtle grid bg -->
    <div aria-hidden="true" class="absolute inset-0 -z-10 grid-background"></div>

    <div class="mt-12 px-6 py-16 sm:py-24 text-center">
      <!-- avatar -->
      <div class="mx-auto mb-8 h-32 w-32" id="hero-avatar">
        <div class="relative h-full w-full">
          <!-- Pulsating rings -->
          <div id="pulse-ring-1" class="absolute inset-0 rounded-full ring-8 ring-blue-300 opacity-0"></div>

          <!-- Main avatar with ring -->
          <div class="relative h-full w-full rounded-full bg-white dark:bg-black p-1 ring-8 ring-blue-400">
            <Image
              src={avatarImage}
              alt="Daniel Garcia"
              class="rounded-full object-cover ring-1 ring-gray-200"
              width={200}
              height={200}
            />
          </div>
        </div>
      </div>

      <h1 id="hero-title" class="mx-auto max-w-4xl text-4xl md:text-6xl font-medium leading-tight tracking-tight">
        Welcome to my little internet space
      </h1>

      <p id="hero-subtitle" class="mx-auto mt-6 max-w-3xl text-xl text-default">
        Thanks for visiting! I've been a Tesla Engineer, a two time failed-startup founder, content creator, full stack
        freelancer. I created this page to share my learnings, technical and non-technical with others in hopes it helps
        somebody.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center" id="hero-buttons">
        <a
          href="/blog/"
          id="blog-btn"
          class="cta-button-primary relative inline-flex items-center justify-center rounded-full overflow-hidden px-8 py-4 text-lg font-semibold shadow-md hover:shadow-xl transition-shadow duration-300"
          data-umami-event="blog-btn-click"
        >
          <span class="relative z-10 text-white dark:text-black">Read the blog</span>
        </a>

        <a
          href="#my-story"
          id="story-btn"
          data-umami-event="story-btn-click"
          class="cta-button-secondary relative inline-flex items-center justify-center rounded-full overflow-hidden border border-black/10 dark:border-white/20 px-8 py-4 text-lg font-semibold shadow-md hover:shadow-xl transition-shadow duration-300"
        >
          <span class="relative z-10 text-black dark:text-white">My story</span>
        </a>
      </div>
    </div>
  </section>

  <!-- My Story Section -->
  <section id="my-story" class="py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="about-container">
        <div class="about-image opacity-0">
          <Image src={meImage} alt="Daniel Garcia" class="rounded-2xl" width={400} height={400} />
        </div>
        <div class="about-content">
          <h2 class="about-title opacity-0">Hey, I'm Daniel</h2>
          <p class="about-text opacity-0">
            An Industrial Engineer from Madrid turned full stack developer and indie hacker. I write here about what I
            learn along the way: code, business, and everything in between.
          </p>
        </div>
      </div>

      <!-- Timeline -->
      <h3 class="story-subtitle opacity-0">My journey</h3>
      <div class="relative border-l-2 border-gray-300 dark:border-gray-700 pl-8 space-y-8">
        {
          timelineItems.map((item) => (
            <div class="timeline-item opacity-0 relative">
              {/* Timeline dot */}
              <div class="absolute -left-[41px] w-4 h-4 bg-blue-500 rounded-full" />

              {/* Timeline content */}
              <div class="mb-4">
                <span class="text-sm font-semibold text-blue-500">{item.dates}</span>
                {item.image && (
                  <div class="mt-4 mb-4">
                    <Image src={item.image} alt={item.imageAlt} class="rounded-lg shadow-lg w-full max-w-2xl" />
                  </div>
                )}
                <div class="text-default mt-2 prose dark:prose-invert max-w-none" set:html={item.description} />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Consulting Section -->
  <section id="consulting" class="py-16 px-6">
    <div class="max-w-3xl mx-auto">
      <div class="consulting-card">
        <h3 class="consulting-headline opacity-0">I take a few freelance clients each month.</h3>

        <p class="consulting-intro opacity-0">
          I mainly build software tools, web apps, automations, AI integrations, websites and data dashboards on Grafana.
        </p>

        <div class="consulting-services opacity-0">
          {
            services.map((service) => (
              <div class="service-item">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-5 h-5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                <span>{service}</span>
              </div>
            ))
          }
        </div>

        <div class="consulting-cta opacity-0">
          <a
            href="https://cal.com/onticdani/30min"
            target="_blank"
            class="consulting-btn"
            data-umami-event="consulting-request-click"
          >
            Let's have a chat
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Smooth scrolling for anchor links */
    html {
      scroll-behavior: smooth;
    }

    /* Add scroll margin to sections for anchor link navigation */
    section[id] {
      scroll-margin-top: 6rem;
    }

    /* Grid background styling */
    .grid-background {
      background-image:
        linear-gradient(to right, rgba(0, 0, 0, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0, 0, 0, 0.05) 1px, transparent 1px);
      background-size: 28px 28px;
      mask-image:
        linear-gradient(to bottom, black 20%, transparent 100%),
        linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%),
        linear-gradient(to bottom, transparent 0%, black 10%);
      mask-composite: intersect;
      -webkit-mask-image:
        linear-gradient(to bottom, black 20%, transparent 100%),
        linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%),
        linear-gradient(to bottom, transparent 0%, black 10%);
      -webkit-mask-composite: source-in;
    }

    :root.dark .grid-background {
      background-image:
        linear-gradient(to right, rgba(255, 255, 255, 0.15) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.15) 1px, transparent 1px);
    }

    @keyframes gradient-shift {
      0%,
      100% {
        background-position: 0% 50%;
      }
      50% {
        background-position: 100% 50%;
      }
    }

    .cta-button-primary {
      background: black;
    }

    :root.dark .cta-button-primary {
      background: white;
    }

    .cta-button-primary::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(45deg, #3b82f6, #8b5cf6, #ec4899, #10b981, #3b82f6);
      background-size: 300% 300%;
      animation: gradient-shift 6s ease infinite;
      z-index: 0;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .cta-button-primary:hover::before {
      opacity: 1;
    }

    .cta-button-secondary::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        45deg,
        rgba(59, 130, 246, 0.2),
        rgba(139, 92, 246, 0.2),
        rgba(236, 72, 153, 0.2),
        rgba(16, 185, 129, 0.2),
        rgba(59, 130, 246, 0.2)
      );
      background-size: 300% 300%;
      animation: gradient-shift 6s ease infinite;
      z-index: 0;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .cta-button-secondary {
      background: rgba(255, 255, 255, 0.7);
    }

    :root.dark .cta-button-secondary {
      background: transparent;
    }

    .cta-button-secondary:hover::before {
      opacity: 1;
    }

    /* Hero elements initial state - hidden and shifted down */
    #hero-title,
    #hero-subtitle {
      opacity: 0;
    }

    #hero-avatar {
      opacity: 0;
      transform: translateY(20px);
    }

    #hero-buttons {
      opacity: 0;
      transform: translateY(20px);
    }

    /* Text animation styling */
    .word-wrapper {
      display: inline-block;
      opacity: 0;
      filter: blur(10px);
      transform: translateY(10px);
    }

    /* My Story Section Styles */
    #my-story {
      position: relative;
    }

    .about-container {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.5rem;
      align-items: center;
    }

    @media (min-width: 768px) {
      .about-container {
        grid-template-columns: 1fr 1.5fr;
        gap: 3rem;
      }
    }

    .about-image {
      display: flex;
      justify-content: center;
    }

    .about-image img {
      width: 100%;
      max-width: 300px;
      height: auto;
      object-fit: cover;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
      transition: all 0.3s ease;
    }

    :root.dark .about-image img {
      box-shadow: 0 8px 24px rgba(255, 255, 255, 0.1);
    }

    .about-image img:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
    }

    :root.dark .about-image img:hover {
      box-shadow: 0 12px 32px rgba(255, 255, 255, 0.15);
    }

    @media (min-width: 768px) {
      .about-image img {
        max-width: 100%;
      }
    }

    .about-content {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .about-title {
      font-size: 2rem;
      font-weight: 700;
      color: rgba(0, 0, 0, 0.9);
      margin: 0;
    }

    :root.dark .about-title {
      color: rgba(255, 255, 255, 0.95);
    }

    @media (min-width: 768px) {
      .about-title {
        font-size: 2.5rem;
      }
    }

    .about-text {
      font-size: 1.125rem;
      line-height: 1.8;
      color: rgba(0, 0, 0, 0.75);
      margin: 0;
    }

    :root.dark .about-text {
      color: rgba(255, 255, 255, 0.8);
    }

    @media (min-width: 768px) {
      .about-text {
        font-size: 1.25rem;
      }
    }

    .story-subtitle {
      font-size: 1.5rem;
      font-weight: 700;
      margin: 3.5rem 0 2rem;
      color: rgba(0, 0, 0, 0.9);
    }

    :root.dark .story-subtitle {
      color: rgba(255, 255, 255, 0.95);
    }

    @media (min-width: 768px) {
      .story-subtitle {
        font-size: 1.75rem;
      }
    }

    /* Consulting Section Styles */
    #consulting {
      position: relative;
    }

    .consulting-card {
      background: rgba(255, 255, 255, 0.5);
      border: 1px solid rgba(0, 0, 0, 0.06);
      border-radius: 16px;
      padding: 2rem 2rem;
      transition: all 0.3s ease;
    }

    :root.dark .consulting-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .consulting-headline {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      text-align: center;
      color: rgba(0, 0, 0, 0.85);
    }

    :root.dark .consulting-headline {
      color: rgba(255, 255, 255, 0.9);
    }

    @media (min-width: 768px) {
      .consulting-headline {
        font-size: 1.75rem;
      }
    }

    .consulting-intro {
      text-align: center;
      font-size: 1rem;
      line-height: 1.7;
      margin-bottom: 1.5rem;
      color: rgba(0, 0, 0, 0.7);
    }

    :root.dark .consulting-intro {
      color: rgba(255, 255, 255, 0.75);
    }

    .consulting-services {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
      margin-bottom: 2rem;
    }

    @media (min-width: 640px) {
      .consulting-services {
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
      }
    }

    .service-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.9rem;
      color: rgba(0, 0, 0, 0.75);
      transition: all 0.2s ease;
    }

    :root.dark .service-item {
      color: rgba(255, 255, 255, 0.8);
    }

    .service-item svg {
      flex-shrink: 0;
      color: #3b82f6;
    }

    :root.dark .service-item svg {
      color: #60a5fa;
    }

    .service-item:hover {
      color: #3b82f6;
    }

    :root.dark .service-item:hover {
      color: #60a5fa;
    }

    .consulting-cta {
      display: flex;
      justify-content: center;
    }

    .consulting-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(0, 0, 0, 0.85);
      color: white;
      padding: 0.875rem 1.75rem;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.3s ease;
      border: 1px solid rgba(0, 0, 0, 0.1);
    }

    :root.dark .consulting-btn {
      background: rgba(255, 255, 255, 0.9);
      color: black;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .consulting-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
      gap: 0.75rem;
    }

    :root.dark .consulting-btn:hover {
      box-shadow: 0 8px 16px rgba(255, 255, 255, 0.2);
    }

    .consulting-btn svg {
      transition: transform 0.3s ease;
    }

    .consulting-btn:hover svg {
      transform: translateX(3px);
    }

    /* Skip the reveal animations entirely for reduced-motion visitors */
    @media (prefers-reduced-motion: reduce) {
      .opacity-0,
      .word-wrapper,
      #hero-title,
      #hero-subtitle,
      #hero-avatar,
      #hero-buttons {
        opacity: 1 !important;
        filter: none !important;
        transform: none !important;
      }
    }
  </style>

  <script>
    import { animate } from 'motion';

    // Wait for DOM to be ready
    document.addEventListener('DOMContentLoaded', () => {
      // Function to split text into words and wrap each in a span
      const splitTextIntoWords = (element: HTMLElement) => {
        const text = element.innerHTML;
        const parser = new DOMParser();
        const doc = parser.parseFromString(text, 'text/html');

        const processNode = (node: Node): Node[] => {
          if (node.nodeType === Node.TEXT_NODE) {
            const words = node.textContent?.trim().split(/(\s+)/) || [];
            return words.map((word) => {
              if (word.trim() === '') {
                // Preserve whitespace
                return document.createTextNode(word);
              }
              const span = document.createElement('span');
              span.className = 'word-wrapper';
              span.textContent = word;
              return span;
            });
          } else if (node.nodeType === Node.ELEMENT_NODE) {
            const element = node as HTMLElement;
            const newElement = element.cloneNode(false) as HTMLElement;
            Array.from(element.childNodes).forEach((child) => {
              processNode(child).forEach((newChild) => {
                newElement.appendChild(newChild);
              });
            });
            return [newElement];
          }
          return [node.cloneNode(true)];
        };

        element.innerHTML = '';
        Array.from(doc.body.childNodes).forEach((node) => {
          processNode(node).forEach((newNode) => {
            element.appendChild(newNode);
          });
        });
      };

      // Animate text with blur fade-in effect
      const animateText = async (selector: string, delayOffset = 0) => {
        const element = document.querySelector(selector) as HTMLElement;
        if (!element) return;

        // Make parent element visible immediately
        element.style.opacity = '1';

        splitTextIntoWords(element);
        const words = element.querySelectorAll('.word-wrapper');

        // Animate each word with stagger
        words.forEach((word, index) => {
          animate(
            word as HTMLElement,
            {
              opacity: [0, 1],
              filter: ['blur(10px)', 'blur(0px)'],
              y: [10, 0],
            },
            {
              duration: 0.6,
              delay: delayOffset + index * 0.04,
              easing: [0.22, 1, 0.36, 1], // Custom ease-out curve
            } as any
          );
        });

        // Return promise that resolves when animation is complete
        return new Promise((resolve) => {
          setTimeout(
            () => {
              resolve(true);
            },
            delayOffset + words.length * 40 + 600
          );
        });
      };

      // Start text animations immediately
      animateText('#hero-title', 0);

      // Start subtitle animation while title is still animating for continuous flow
      setTimeout(() => {
        animateText('#hero-subtitle', 0);
      }, 400); // Start subtitle after first few words of title

      // Animate hero elements with fade-in and slide-up after text animations
      setTimeout(() => {
        const heroAvatar = document.querySelector('#hero-avatar') as HTMLElement;
        const heroButtons = document.querySelector('#hero-buttons') as HTMLElement;

        if (heroAvatar) {
          animate(
            heroAvatar,
            {
              opacity: [0, 1],
              y: [20, 0],
            },
            {
              duration: 0.8,
              easing: 'ease-out',
            } as any
          );
        }

        if (heroButtons) {
          animate(
            heroButtons,
            {
              opacity: [0, 1],
              y: [20, 0],
            },
            {
              duration: 0.8,
              delay: 0.15,
              easing: 'ease-out',
            } as any
          );
        }
      }, 1800); // Delay after text animations complete

      // Animate the pulsating rings
      const animatePulse = (selector: string) => {
        const element = document.querySelector(selector);
        if (element) {
          animate(
            element as HTMLElement,
            {
              scale: [1, 1.4],
              opacity: [0, 0.7, 0],
            },
            {
              duration: 1.5,
              repeat: Infinity,
              easing: 'ease-out',
            } as any
          );
        }
      };

      // Start pulsating animation
      animatePulse('#pulse-ring-1');

      // Animate buttons on hover
      const animateButton = (buttonId: string) => {
        const button = document.querySelector(buttonId);
        if (!button) return;

        button.addEventListener('mouseenter', () => {
          animate(button as HTMLElement, { scale: 1.05 }, { duration: 0.3, easing: 'ease-out' } as any);
        });

        button.addEventListener('mouseleave', () => {
          animate(button as HTMLElement, { scale: 1 }, { duration: 0.3, easing: 'ease-out' } as any);
        });
      };

      animateButton('#blog-btn');
      animateButton('#story-btn');

      // Fade an element up into view
      const fadeUp = (element: Element, delay: number) => {
        animate(
          element as HTMLElement,
          {
            opacity: [0, 1],
            y: [20, 0],
          },
          {
            duration: 0.7,
            delay,
            easing: [0.22, 1, 0.36, 1],
          } as any
        );
      };

      // Run a callback once its section scrolls into view
      const onceInView = (selector: string, callback: () => void) => {
        const section = document.querySelector(selector);
        if (!section) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                callback();
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.1,
            rootMargin: '0px',
          }
        );
        observer.observe(section);
      };

      // Animate My Story section on scroll into view
      onceInView('#my-story', () => {
        const aboutImage = document.querySelector('.about-image');
        const aboutTitle = document.querySelector('.about-title');
        const aboutText = document.querySelector('.about-text');

        if (aboutImage) {
          animate(
            aboutImage as HTMLElement,
            {
              opacity: [0, 1],
              x: [-40, 0],
            },
            {
              duration: 0.8,
              delay: 0.1,
              easing: [0.22, 1, 0.36, 1],
            } as any
          );
        }

        if (aboutTitle) fadeUp(aboutTitle, 0.3);
        if (aboutText) fadeUp(aboutText, 0.45);
      });

      // Reveal the section subtitles and each timeline item as they scroll into view
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              fadeUp(entry.target, 0);
              revealObserver.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.1,
          rootMargin: '0px 0px -5% 0px',
        }
      );
      document
        .querySelectorAll('.story-subtitle, .timeline-item')
        .forEach((element) => revealObserver.observe(element));

      // Animate Consulting section on scroll into view
      onceInView('#consulting', () => {
        const consultingHeadline = document.querySelector('.consulting-headline');
        const consultingIntro = document.querySelector('.consulting-intro');
        const consultingServices = document.querySelector('.consulting-services');
        const consultingCta = document.querySelector('.consulting-cta');

        if (consultingHeadline) fadeUp(consultingHeadline, 0.1);
        if (consultingIntro) fadeUp(consultingIntro, 0.2);
        if (consultingServices) fadeUp(consultingServices, 0.3);
        if (consultingCta) fadeUp(consultingCta, 0.5);
      });
    });
  </script>

  <script>
    // Redirect to Spanish version if user lands directly and browser language is Spanish
    (function () {
      // Check if this is a direct visit (not from same site)
      const referrer = document.referrer;
      const currentDomain = window.location.hostname;
      const isDirectVisit = !referrer || !referrer.includes(currentDomain);

      // Check if we've already done this redirect in this session
      const hasRedirected = sessionStorage.getItem('locale-redirect-checked');

      if (isDirectVisit && !hasRedirected) {
        // Get browser language preference
        const browserLang = navigator.language || navigator.languages?.[0];

        // Check if Spanish is preferred (es, es-ES, es-MX, etc.)
        if (browserLang && browserLang.toLowerCase().startsWith('es')) {
          // Mark that we've checked to avoid redirect loops
          sessionStorage.setItem('locale-redirect-checked', 'true');
          // Redirect to Spanish version
          window.location.href = '/es/';
        } else {
          // Mark as checked even if not redirecting
          sessionStorage.setItem('locale-redirect-checked', 'true');
        }
      }
    })();
  </script>
</PageLayout>
